# ==============================================
# PSX STOCKKING FRONTEND CONFIGURATION (.env)
# ==============================================

# Backend API Base URL
# Local Development: /api (handled automatically by Vite proxy on port 3000)
# Production / Remote Server: https://psx-stockking-backend.vercel.app/api
VITE_API_URL=https://psx-stockking-backend.vercel.app/api

# Application Title
VITE_APP_TITLE=PSX ALPHA TERMINAL

# Supabase Auth Configuration (Google Social OAuth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key